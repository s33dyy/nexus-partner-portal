# Copy this file to `.env` for local development.
# For Railway, let the platform provide DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/livey_partner_portal

# Required by `bun run db:bootstrap` (scripts/bootstrap-db.ts) — becomes the
# login password for the primary super admin seed account, maya.admin@livey.tech.
# The other 14 demo accounts use the fixed passwords in scripts/prod-demo-fixtures.ts
# (see docs/DOCKER_SETUP.md for the full credential list).
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Zoho Sign (Indian data centre — https://api-console.zoho.in/)
ZOHO_SIGN_CLIENT_ID=
ZOHO_SIGN_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_SIGN_API_URL=https://sign.zoho.in
ZOHO_SIGN_REDIRECT_URI=http://localhost:3000/api/integrations/zoho-sign/callback
ZOHO_SIGN_TEMPLATE_ID=   # Optional: Zoho Sign template ID for the partner agreement
ZOHO_SIGN_WEBHOOK_SECRET= # Required: HMAC secret for webhook signature validation. Must match the
                          # secret configured in Zoho Sign's webhook settings — without it, every
                          # inbound webhook is rejected (fails closed, not open).
SIGN_PROVIDER=zohosign

# Google Sign-In (https://console.cloud.google.com/apis/credentials) — login,
# signup, and "Connect Google Account" in Settings. Identity only (openid
# email profile scope) — no persistent Google token storage, unlike Zoho Sign
# above, since nothing calls Google's API again after the callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# OpenRouter (https://openrouter.ai/keys) — powers the in-app Assistant.
# The assistant always auto-selects the cheapest available chat model.
OPENROUTER_API_KEY=

# Twilio (https://console.twilio.com/) — WhatsApp Assistant. Verify Service
# is used only to OTP-link a partner's WhatsApp number to their account (via
# SMS, not WhatsApp) in Settings; TWILIO_WHATSAPP_FROM is the shared sandbox
# (or production) WhatsApp sender number in E.164 (no "whatsapp:" prefix).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WHATSAPP_FROM=

# Twilio Voice (Call Center Phase 1) — browser softphone calling for
# livey_support/super_admin. Signature verification on the three voice
# webhooks reuses TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN above; these four are
# Voice-specific. TWILIO_VOICE_NUMBER is a Voice-capable Twilio number
# (Console > Phone Numbers) — separate from the WhatsApp sandbox number,
# which can't do PSTN voice. TWILIO_TWIML_APP_SID is a TwiML Application
# (Console > Voice > TwiML Apps) whose Voice Request URL/status callback
# point at /api/integrations/twilio/voice/{incoming,outgoing,status}.
# TWILIO_VOICE_API_KEY_SID/SECRET is a separate API Key pair (Console >
# Account > API keys) used only to mint browser Voice Access Tokens — per
# Twilio's own guidance, not the main Account SID/Auth Token.
TWILIO_VOICE_NUMBER=
TWILIO_TWIML_APP_SID=
TWILIO_VOICE_API_KEY_SID=
TWILIO_VOICE_API_KEY_SECRET=
