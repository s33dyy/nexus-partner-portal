# Copy this file to `.env` for local development.
# For Railway, let the platform provide DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/livey_partner_portal

# Required by `bun run db:bootstrap` (scripts/bootstrap-db.ts) — becomes the
# login password for the primary super admin seed account, maya.admin@livey.tech.
# The other 14 demo accounts use the fixed passwords in scripts/prod-demo-fixtures.ts
# (see docs/DOCKER_SETUP.md for the full credential list).
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Zoho Sign (Indian data centre — https://api-console.zoho.in/)
ZOHO_SIGN_CLIENT_ID=
ZOHO_SIGN_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_SIGN_API_URL=https://sign.zoho.in
ZOHO_SIGN_REDIRECT_URI=http://localhost:3000/api/integrations/zoho-sign/callback
ZOHO_SIGN_TEMPLATE_ID=   # Optional: Zoho Sign template ID for the partner agreement
ZOHO_SIGN_WEBHOOK_SECRET= # Required: HMAC secret for webhook signature validation. Must match the
                          # secret configured in Zoho Sign's webhook settings — without it, every
                          # inbound webhook is rejected (fails closed, not open).
SIGN_PROVIDER=zohosign

# Google Sign-In (https://console.cloud.google.com/apis/credentials) — login,
# signup, and "Connect Google Account" in Settings. Identity only (openid
# email profile scope) — no persistent Google token storage, unlike Zoho Sign
# above, since nothing calls Google's API again after the callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# OpenRouter (https://openrouter.ai/keys) — powers the in-app Assistant.
# The assistant always auto-selects the cheapest available chat model.
OPENROUTER_API_KEY=

# Twilio (https://console.twilio.com/) — WhatsApp Assistant. Verify Service
# is used only to OTP-link a partner's WhatsApp number to their account (via
# SMS, not WhatsApp) in Settings; TWILIO_WHATSAPP_FROM is the shared sandbox
# (or production) WhatsApp sender number in E.164 (no "whatsapp:" prefix).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WHATSAPP_FROM=

# Twilio Voice (Call Center Phase 1) — browser softphone calling for
# livey_support/super_admin. Signature verification on the three voice
# webhooks reuses TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN above; these four are
# Voice-specific. TWILIO_VOICE_NUMBER is a Voice-capable Twilio number
# (Console > Phone Numbers) — separate from the WhatsApp sandbox number,
# which can't do PSTN voice. TWILIO_TWIML_APP_SID is a TwiML Application
# (Console > Voice > TwiML Apps) whose Voice Request URL/status callback
# point at /api/integrations/twilio/voice/{incoming,outgoing,status}.
# TWILIO_VOICE_API_KEY_SID/SECRET is a separate API Key pair (Console >
# Account > API keys) used only to mint browser Voice Access Tokens — per
# Twilio's own guidance, not the main Account SID/Auth Token.
TWILIO_VOICE_NUMBER=
TWILIO_TWIML_APP_SID=
TWILIO_VOICE_API_KEY_SID=
TWILIO_VOICE_API_KEY_SECRET=

# --- Proposed-completion-date reminders -------------------------------------
# The reminder sweep looks for Tasks/Deals whose proposed completion date is
# 3 days out, 1 day out, today, 1 day overdue, or 7 days overdue, and delivers
# on three channels: in-app notifications (always), WhatsApp (reuses the
# Twilio config above; only for profiles with a verified number), and email
# (below). Every delivery is claimed in reminder_dispatches first, so running
# the interval AND an external cron AND multiple replicas cannot double-send.

# Set to false to run the app with the background sweep dormant. Default: true.
REMINDERS_ENABLED=true
# How often the in-process sweep runs. Default: 30 (minimum 1).
REMINDERS_INTERVAL_MINUTES=30

# IANA timezone the whole app treats as "the business day". Shared by the
# reminder sweep (which day is "today"?) and the daily digest (is it evening
# yet? what counts as today's activity?), so the two can never disagree.
# Containers run in UTC, which would otherwise flip the day at 5:30am for an
# India-based team and greet them with "Good evening" at 11:30pm.
# Default: UTC.
APP_TIMEZONE=Asia/Kolkata

# Shared secret for POST /api/jobs/reminders, so an external scheduler can
# drive the sweep instead of (or as well as) the in-process interval. Send it
# as `x-jobs-secret: <value>` or `Authorization: Bearer <value>`. When unset,
# the endpoint returns 503 — it is never left open unauthenticated.
JOBS_SECRET=

# Absolute base URL of the deployed portal, used to build "open it here"
# links in reminder emails, and the open-tracking pixel and unsubscribe link
# in outreach sequence emails. Leave blank to send reminders without a link —
# outreach emails then go out with no unsubscribe footer and no open
# tracking, so set this before running a sequence against real recipients.
APP_BASE_URL=

# Transactional email. Set EMAIL_FROM plus exactly one API key; Resend wins
# if both are present. With none of these set, email delivery is skipped and
# logged once — in-app and WhatsApp reminders still go out.
#
# These are the FALLBACK. A Super Admin can also save a provider, key, and
# from-address from Settings → Email delivery, and a key saved there takes
# precedence over the variables below — so a deployment can be given a mail
# provider without a redeploy. "Remove saved key" in that card drops back to
# whatever is set here. The saved key is write-only: it is never returned to
# a browser, only its last four characters.
EMAIL_FROM=
RESEND_API_KEY=
SENDGRID_API_KEY=

# Daily digest email. Sends one summary per recipient per day, at or after
# DIGEST_EMAIL_HOUR in APP_TIMEZONE, using the same email provider as
# reminders above. Every fact in it comes from the same capability-gated
# digest the in-app dialog shows, so it can't leak anything the UI hides.
# Set to false to keep the in-app briefing but stop the email. Default: true.
DIGEST_EMAIL_ENABLED=true
# Hour (0-23, APP_TIMEZONE) at or after which the day's digest may send.
# Default: 8.
DIGEST_EMAIL_HOUR=8
