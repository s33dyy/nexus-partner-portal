{
  "name": "livey-pam-crm",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:backend": "bun --filter @livey/backend dev",
    "dev:frontend": "bun --filter @livey/frontend dev",
    "build:backend": "bun --filter @livey/backend build",
    "build:frontend": "bun --filter @livey/frontend build",
    "db:migrate": "bun --filter @livey/backend db:migrate",
    "db:bootstrap": "bun --filter @livey/backend db:bootstrap",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.16.5",
    "bun-types": "^1.3.14",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  }
}
