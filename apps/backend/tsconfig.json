{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "compilerOptions": {
    // Bun implements the Web APIs these server files use (fetch, Request,
    // Response, FormData, File, crypto) — DOM supplies their types.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun-types"],
    "paths": {
      "@/*": ["./src/*"],
      "@/domain/contracts/*": ["../../packages/shared/src/contracts/*"],
      "@livey/shared/*": ["../../packages/shared/src/*"]
    }
  }
}
